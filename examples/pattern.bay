si x = 0;
si y = 0;
si h = 5;
si w = 5;
si output ay "";

habang (y < w){
  habang (x < y){
    output = (output + "* ");
    x = (x + 1);
  }
  output = output + "\n";
  x = 0;
  y = (y + 1);
}

sabihin output;

// Baybayin
ᜐᜒ ᜉᜑᜒᜄ ᜀᜌ᜔ 0᜶
ᜐᜒ ᜉᜆᜌᜓ ᜀᜌ᜔ 0᜶
ᜐᜒ ᜆᜀᜐ᜔ ᜀᜌ᜔ 10᜶
ᜐᜒ ᜎᜉᜇ᜔ ᜀᜌ᜔ 5᜶
ᜐᜒ ᜃᜊᜓᜂᜀᜈ᜔ ᜀᜌ᜔ ""᜶

ᜑᜊᜅ᜔ (ᜉᜆᜌᜓ < ᜆᜀᜐ᜔){
  ᜑᜊᜅ᜔ (ᜉᜑᜒᜄ < ᜉᜆᜌᜓ){
    ᜃᜊᜓᜂᜀᜈ᜔ ᜀᜌ᜔ (ᜃᜊᜓᜂᜀᜈ᜔ + "* ")᜶
    ᜉᜑᜒᜄ ᜀᜌ᜔ (ᜉᜑᜒᜄ + 1)᜶
  }
  ᜃᜊᜓᜂᜀᜈ᜔ ᜀᜌ᜔ ᜃᜊᜓᜂᜀᜈ᜔ + "\n"᜶
  ᜉᜑᜒᜄ ᜀᜌ᜔ 0᜶
  ᜉᜆᜌᜓ ᜀᜌ᜔ (ᜉᜆᜌᜓ + 1)᜶
}

ᜐᜊᜒᜑᜒᜈ᜔ ᜃᜊᜓᜂᜀᜈ᜔᜶


