// Variable declaration and usage sample

// Si
si user = "si kim";
sabihin ("sino si user? si user ay " + user);

// Si in baybayin
ᜐᜒ ᜂᜐᜒᜇ᜔ = "ᜐᜒ ᜃᜒᜋ᜔"᜶
ᜐᜊᜒᜑᜒᜈ᜔ ("ᜐᜒᜈᜓ ᜐᜒ ᜂᜐᜒᜇ᜔᜶ ᜐᜒ ᜂᜐᜒᜇ᜔ ᜀᜌ᜔ " + ᜂᜐᜒᜇ᜔)᜶

// Ipangalan
ipangalan pangalan = "Maynila";
ipangalan edad = 2026;

ipaliwanag pangalan;
ipaliwanag edad;

// Ipangalan in Baybayin
ᜁᜉᜅᜎᜈ᜔ ᜉᜅᜎᜈ᜔ = "ᜋᜌ᜔ᜈᜒᜎ"᜵
ᜁᜉᜅᜎᜈ᜔ ᜁᜇᜇ᜔ = 2026 ᜵
ᜁᜉᜎᜒᜏᜈᜄ᜔ ᜉᜅᜎᜈ᜔ ᜵
ᜁᜉᜎᜒᜏᜈᜄ᜔ ᜁᜇᜇ᜔ ᜵
