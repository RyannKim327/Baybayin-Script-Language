// Paggawa ng Pattern gamit ang habang (while loop)
si x ay 0;
si y ay 0;
si h ay isalin(pahingi("Gaano ito kataas: "), numero);
si w ay h;
si sagot ay "";

habang (y < h) {
  si z ay 0;
  habang (z < (h - y)) {
    sagot = (sagot + " ");
    z = (z + 1);
  }

  habang (x < y) {
    sagot = (sagot + "* ");
    x = (x + 1);
  }

  sagot = sagot + "\n";
  x = 0;
  y = (y + 1);
}

sabihin sagot;
